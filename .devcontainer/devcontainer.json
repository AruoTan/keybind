{
    "name": "autohotkey",
    "build": {
        "dockerfile": "Dockerfile",
        "context": "."
    },
    "remoteUser": "vscode",
    "postCreateCommand": "bash .devcontainer/scripts/setup-tools.sh --check",
    "customizations": {
        "vscode": {
            "extensions": [
                "mark-wiemer.vscode-autohotkey-plus-plus"
            ]
        }
    }
}
